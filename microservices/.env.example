# Common DB
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_db_password_here
DB_NAME=postgres
DB_SYNCHRONIZE=true

# Auth
JWT_SECRET=dev_only_change_me
APP_BASE_URL=http://localhost:3009

# Email delivery handled by notification-service
# Option 1: Generic SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=no-reply@eventhive.local

# Option 2: Gmail (use App Password)
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Password reset + email confirmation URLs
RESET_PASSWORD_TTL_MINUTES=60

# Async events
RABBITMQ_URL=amqp://localhost:5672

# Service endpoints used by gateway/mobile (override in containers or staging)
USER_SERVICE_URL=http://localhost:3000
EVENT_SERVICE_URL=http://localhost:3001
TICKETING_SERVICE_URL=http://localhost:3002
NOTIFICATION_SERVICE_URL=http://localhost:3003
CREDENTIAL_SERVICE_URL=http://localhost:3004
AGENDA_SERVICE_URL=http://localhost:3005
ANALYTICS_SERVICE_URL=http://localhost:3006

# Payments (Stripe)
# Get test keys at: https://dashboard.stripe.com/apikeys
STRIPE_API_KEY=your_stripe_test_key_here

# Payments (PayPal - optional)
# Get credentials at: https://developer.paypal.com/
PAYPAL_CLIENT_ID=your_paypal_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_client_secret_here
PAYPAL_MODE=sandbox

# Observability
PROMETHEUS_PORT=9090

