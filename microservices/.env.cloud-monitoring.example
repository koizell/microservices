# Variables para docker-compose.cloud-monitoring.yml
# Copia este archivo a .env.cloud-monitoring (gitignored) y completa los valores.

# Connection string del pooler de Supabase. Mismo formato que la DATABASE_URL
# que tienes en Render. Postgres-exporter lo usa para extraer metricas.
# Ejemplo:
#   postgresql://postgres.{ref}:{password}@aws-0-{region}.pooler.supabase.com:6543/postgres?sslmode=require
SUPABASE_DATABASE_URL=
